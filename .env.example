# Copy to .env, fill local values, then load with: set -a; . ./.env; set +a
# SHA-256 hash of the bearer API key accepted by the service. Never store the key.
LAS_API_KEY_SHA256=

# API control-plane listen address. Keep loopback unless a trusted proxy/firewall
# provides TLS and access control.
LAS_API_HOST=127.0.0.1
LAS_API_PORT=8000

# Runtime storage and source-media policy. Before startup, create the database
# parent and work directory as the dedicated service UID (recommended modes:
# 0700). The database parent must not be a symlink or writable by group/other;
# every ancestor must be a real directory owned by root/the service UID, with
# writable ancestors allowed only when sticky. Database/WAL/SHM files must be
# 0600. Same-UID processes with ancestry write access are trusted; keep allowed,
# potentially requester-controlled media outside the database directory.
LAS_DATABASE_PATH=data/las-repro.sqlite3
LAS_WORK_ROOT=work
LAS_ALLOWED_MEDIA_ROOTS=media
LAS_MAX_DOWNLOAD_BYTES=10737418240

# Local model and worker configuration.
LAS_MODEL_REGISTRY='{"qwen3-vl-8b-instruct":"models/qwen3-vl-8b-instruct"}'
LAS_BACKEND=qwen3_vl
LAS_GPU_DEVICES=0,1,2,3
LAS_MAX_MODEL_OUTPUT_CHARS=1000000
LAS_SEGMENT_SECONDS=30.0
LAS_SEGMENT_OVERLAP_SECONDS=2.0
LAS_MAX_FINE_SEGMENT_SECONDS=1.0
LAS_LEASE_SECONDS=300

# Optional Volcengine TOS configuration. Do not commit real credentials.
LAS_TOS_ENDPOINT=
LAS_TOS_REGION=
LAS_TOS_ACCESS_KEY=
LAS_TOS_SECRET_KEY=
