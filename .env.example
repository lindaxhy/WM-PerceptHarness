# Copy to .env, fill in ONE backend, then load with: set -a; . ./.env; set +a

# --- Backend: doubao (remote ARK; no GPU needed) ---------------------------
# The only required field for --backend doubao. Sampled JPEG frames (never
# audio or local filenames) are sent to Volcengine ARK.
LAS_ARK_API_KEY=
LAS_ARK_MODEL_REGISTRY='{"doubao-pro":"doubao-seed-2-1-pro-260628"}'
# Optional explicit HTTPS proxy; ambient proxy variables are ignored.
LAS_ARK_PROXY=

# --- Backend: qwen (local GPU inference) -----------------------------------
# Alias -> local snapshot directory (see scripts/download_model.py).
LAS_MODEL_REGISTRY='{"qwen3-vl-8b-instruct":"models/qwen3-vl-8b-instruct"}'
LAS_GPU_DEVICES=0,1,2

# --- Optional tuning (defaults are fine) -----------------------------------
#LAS_SEGMENT_SECONDS=30.0
#LAS_SEGMENT_OVERLAP_SECONDS=2.0
#LAS_ARK_TIMEOUT_SECONDS=180
#LAS_ARK_MAX_FRAMES=128
