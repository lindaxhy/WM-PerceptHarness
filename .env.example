# Copy to .env, fill in the backend, then load with: set -a; . ./.env; set +a

# --- Backend: openai (any OpenAI-compatible chat completions endpoint) ------
# Works with Doubao ARK, DashScope, OpenAI, Gemini's compatibility layer, and
# any local model served by vLLM/SGLang. Sampled JPEG frames (never audio or
# local filenames) are sent to the endpoint.
PERCEPT_OPENAI_BASE_URL=
PERCEPT_OPENAI_API_KEY=
PERCEPT_OPENAI_MODEL=

# Provider presets — uncomment one BASE_URL/MODEL pair:
#   Doubao ARK:
#     PERCEPT_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#     PERCEPT_OPENAI_MODEL=doubao-seed-2-1-pro-260628
#     PERCEPT_OPENAI_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
#   Qwen (DashScope):
#     PERCEPT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     PERCEPT_OPENAI_MODEL=qwen3-vl-plus
#     PERCEPT_OPENAI_EXTRA_BODY='{"enable_thinking":false}'
#   Local vLLM (vllm serve Qwen/Qwen3-VL-8B-Instruct):
#     PERCEPT_OPENAI_BASE_URL=http://localhost:8000/v1
#     PERCEPT_OPENAI_MODEL=Qwen/Qwen3-VL-8B-Instruct
#     PERCEPT_OPENAI_API_KEY=dummy

# Structured output mode: json_schema | json_object (default) | none.
#PERCEPT_OPENAI_RESPONSE_FORMAT=json_object
# Extra JSON merged into every request body / sent as extra HTTP headers.
#PERCEPT_OPENAI_EXTRA_BODY='{}'
#PERCEPT_OPENAI_EXTRA_HEADERS='{}'
# Several aliases for A/B runs instead of PERCEPT_OPENAI_MODEL:
#PERCEPT_OPENAI_MODEL_REGISTRY='{"doubao-pro":"doubao-seed-2-1-pro-260628"}'
# Optional explicit HTTPS proxy; ambient proxy variables are ignored.
#PERCEPT_OPENAI_PROXY=

# --- Optional tuning (defaults are fine) -----------------------------------
# Fixed per-request timeout in seconds:
#PERCEPT_OPENAI_TIMEOUT_SECONDS=180
# Replay validated per-request results for byte-identical inputs (repair loops,
# task reruns). Disabled automatically under --force independent repeats.
#PERCEPT_SEMANTIC_RESULT_CACHE=true

# --- Mandatory SAM3.1 grounding for production annotation ------------------
#PERCEPT_CV_REPOSITORY_PATH=/absolute/path/to/sam3
#PERCEPT_CV_CHECKPOINT_PATH=/absolute/path/to/sam3.pt
#PERCEPT_CV_BPE_PATH=/absolute/path/to/sam3/sam3/assets/bpe_simple_vocab_16e6.txt.gz
#PERCEPT_CV_CACHE_ROOT=./cv-cache

# --- Separate OpenAI-compatible semantic judge for `percept score events` ---
PERCEPT_JUDGE_BASE_URL=
PERCEPT_JUDGE_MODEL=
PERCEPT_JUDGE_API_KEY=
# Extra JSON merged into each judge request, e.g. for Doubao reasoning models:
#PERCEPT_JUDGE_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
